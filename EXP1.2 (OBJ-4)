% Simulation of a High-Frequency Network Using MATLAB
% Performance Evaluation at Different Operating Frequencies

clc;
clear;
close all;

% Operating Frequencies (GHz)
frequency = [1 2 4 6 8 10 12];

% Reflection Coefficient (S11)
S11 = [0.35 0.30 0.28 0.24 0.20 0.18 0.15];

% Transmission Coefficient (S21)
S21 = [0.65 0.70 0.75 0.80 0.85 0.88 0.92];

% Return Loss Calculation (dB)
ReturnLoss = -20 * log10(abs(S11));

% Insertion Loss Calculation (dB)
InsertionLoss = -20 * log10(abs(S21));

% VSWR Calculation
VSWR = (1 + abs(S11)) ./ (1 - abs(S11));

% Power Transmission Efficiency (%)
Efficiency = (abs(S21).^2) * 100;

% Display Results
fprintf('Freq(GHz)\tRL(dB)\t\tIL(dB)\t\tVSWR\tEfficiency(%%)\n');

for i = 1:length(frequency)
    fprintf('%2d\t\t%6.2f\t\t%6.2f\t\t%5.2f\t%6.2f\n', ...
        frequency(i), ReturnLoss(i), InsertionLoss(i), ...
        VSWR(i), Efficiency(i));
end

% Plot 1: Return Loss vs Frequency
figure;
plot(frequency, ReturnLoss, '-o', 'LineWidth', 2);
grid on;
xlabel('Frequency (GHz)');
ylabel('Return Loss (dB)');
title('Return Loss Characteristics');

% Plot 2: Insertion Loss vs Frequency
figure;
plot(frequency, InsertionLoss, '-s', 'LineWidth', 2);
grid on;
xlabel('Frequency (GHz)');
ylabel('Insertion Loss (dB)');
title('Insertion Loss Characteristics');

% Plot 3: VSWR vs Frequency
figure;
plot(frequency, VSWR, '-^', 'LineWidth', 2);
grid on;
xlabel('Frequency (GHz)');
ylabel('VSWR');
title('VSWR Characteristics');

% Plot 4: Efficiency vs Frequency
figure;
plot(frequency, Efficiency, '-d', 'LineWidth', 2);
grid on;
xlabel('Frequency (GHz)');
ylabel('Efficiency (%)');
title('Power Transmission Efficiency');

% Combined Performance Analysis
figure;
plot(frequency, ReturnLoss, '-o', 'LineWidth', 2);
hold on;
plot(frequency, InsertionLoss, '-s', 'LineWidth', 2);
plot(frequency, Efficiency, '-^', 'LineWidth', 2);
grid on;

xlabel('Frequency (GHz)');
ylabel('Magnitude');
title('High-Frequency Network Performance');
legend('Return Loss', 'Insertion Loss', 'Efficiency');
hold off;

% Average Performance
avg_RL = mean(ReturnLoss);
avg_IL = mean(InsertionLoss);
avg_Eff = mean(Efficiency);

fprintf('\nAverage Return Loss = %.2f dB\n', avg_RL);
fprintf('Average Insertion Loss = %.2f dB\n', avg_IL);
fprintf('Average Efficiency = %.2f %%\n', avg_Eff);
