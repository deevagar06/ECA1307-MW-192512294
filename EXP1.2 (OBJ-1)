% Determination of S-Parameters of a Two-Port Microwave Network
% EX NO: 1

clc;
clear;
close all;

% Incident Wave Amplitudes
a1 = [10 15 20];

% Reflected and Transmitted Waves
b1 = [2 3 4];
b2 = [8 12 16];

% Calculate S-Parameters
S11 = b1 ./ a1;
S21 = b2 ./ a1;

% Reverse Measurements
a2_rev = [10 15 20];
b2_rev = [1 1.5 2];
b1_rev = [7 10 13];

S22 = b2_rev ./ a2_rev;
S12 = b1_rev ./ a2_rev;

% Display Results
disp('Scattering Parameters for Three Cases');
fprintf('Case\tS11\t\tS12\t\tS21\t\tS22\n');

for i = 1:length(a1)
    fprintf('%d\t%.3f\t\t%.3f\t\t%.3f\t\t%.3f\n', i, S11(i), S12(i), S21(i), S22(i));
end

% Display S-Parameter Matrices
for i = 1:length(a1)
    S = [S11(i), S12(i); S21(i), S22(i)];
    fprintf('\nS-Parameter Matrix for Case %d:\n', i);
    disp(S);
end

% Calculate Magnitude in dB
S11_dB = 20 * log10(abs(S11));
S12_dB = 20 * log10(abs(S12));
S21_dB = 20 * log10(abs(S21));
S22_dB = 20 * log10(abs(S22));

% Plot S-Parameters
figure;
plot(1:3, S11_dB, '-o', 'LineWidth', 2);
hold on;
plot(1:3, S21_dB, '-s', 'LineWidth', 2);
plot(1:3, S12_dB, '-^', 'LineWidth', 2);
plot(1:3, S22_dB, '-d', 'LineWidth', 2);

grid on;
xlabel('Case Number');
ylabel('Magnitude (dB)');
title('S-Parameter Characteristics of Two-Port Microwave Network');
legend('S11', 'S21', 'S12', 'S22');
